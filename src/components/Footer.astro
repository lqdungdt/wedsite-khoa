---
import { getEntry } from 'astro:content';

const cauHinh = await getEntry('cauHinh', 'site');
const nam = new Date().getFullYear();
const dienThoaiTel = cauHinh?.data.dien_thoai.replace(/\s/g, '') ?? '';
---

<footer class="bg-khoa text-white">
  <div class="border-b border-white/15">
    <nav class="flex flex-wrap items-center gap-x-2 gap-y-1 px-4 py-3 text-sm font-semibold uppercase tracking-wide">
      <a href="/" class="hover:text-vang">{cauHinh?.data.ten_khoa}</a>
      <span class="text-white/30">|</span>
      <a href="/gioi-thieu" class="hover:text-vang">Giới thiệu</a>
      <span class="text-white/30">|</span>
      <a href="/doi-ngu" class="hover:text-vang">Đội ngũ giảng viên</a>
      <span class="text-white/30">|</span>
      <a href="/bieu-mau" class="hover:text-vang">Biểu mẫu</a>
      <span class="text-white/30">|</span>
      <a href="/lien-he" class="hover:text-vang">Liên hệ</a>
    </nav>
  </div>

  <div class="flex flex-col gap-4 px-4 py-5 sm:flex-row sm:items-center sm:justify-between">
    <address class="flex items-start gap-2 text-sm not-italic text-white/90">
      <span aria-hidden="true">📍</span>
      <span>{cauHinh?.data.ten_truong} — {cauHinh?.data.dia_chi}</span>
    </address>
    <div class="flex items-center gap-4 text-sm text-white/90">
      <a href={`tel:${dienThoaiTel}`} class="hover:text-vang">☎ {cauHinh?.data.dien_thoai}</a>
      <a href={`mailto:${cauHinh?.data.email}`} class="hover:text-vang">✉ {cauHinh?.data.email}</a>
    </div>
  </div>

  <div class="border-t border-white/15 px-4 py-3 text-xs text-white/60">
    © {nam} {cauHinh?.data.ten_khoa} — {cauHinh?.data.ten_truong}. Bảo lưu mọi quyền.
  </div>
</footer>
