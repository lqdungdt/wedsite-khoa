---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import TimKiem from '../components/TimKiem.astro';
import AnhHoatDong from '../components/AnhHoatDong.astro';
import { getCollection } from 'astro:content';
import { ngay } from '../lib/dinh-dang';

// Ảnh nền hero: lấy từ collection "Ảnh banner trang chủ" (tự chỉnh qua /admin,
// mục "Ảnh banner trang chủ" - tải ảnh lên là tự hiện, không cần sửa code).
// Nếu chưa có ảnh nào, dùng tạm ảnh cơ sở trường mặc định.
const anhBannerCms = (await getCollection('anhBanner')).sort((a, b) => a.data.thuTu - b.data.thuTu);
const ANH_HERO = anhBannerCms.length > 0 ? anhBannerCms.map((a) => a.data.anh) : ['/co-so-truong.jpg'];

const tatCaThongBao = (await getCollection('thongBao')).sort((a, b) => {
  if (a.data.noiBat !== b.data.noiBat) return a.data.noiBat ? -1 : 1;
  return b.data.ngayTao.getTime() - a.data.ngayTao.getTime();
});
const thongBao = tatCaThongBao.slice(0, 6);
const noiBat = tatCaThongBao.filter((b) => b.data.noiBat).slice(0, 3);

const tinTuc = (await getCollection('tinTuc'))
  .sort((a, b) => b.data.ngayTao.getTime() - a.data.ngayTao.getTime())
  .slice(0, 4);

const tinMoi = [
  ...tatCaThongBao.map((b) => ({ ...b, duongDanGoc: 'thong-bao' })),
  ...(await getCollection('tinTuc')).map((t) => ({ ...t, duongDanGoc: 'tin-tuc' })),
]
  .sort((a, b) => b.data.ngayTao.getTime() - a.data.ngayTao.getTime())
  .slice(0, 5);
---

<BaseLayout>
  <div class="flex flex-col gap-6 px-4 py-5">
    <div class="grid gap-5 lg:grid-cols-[1.9fr_1fr]">
      <div class="relative min-h-[22rem] overflow-hidden rounded-o">
        <HeroSlideshow anh={ANH_HERO} alt="Ảnh hoạt động Trường Cao đẳng Y tế Đồng Tháp" />
      </div>

      <aside class="flex flex-col gap-6">
        <section>
          <TimKiem />
        </section>

        <section class="flex flex-1 flex-col">
          <div class="thanh-muc">Tin mới nhất</div>
          <div class="flex flex-1 flex-col divide-y divide-ke rounded-b-o border border-t-0 border-ke bg-giay-sang">
            {
              tinMoi.length === 0 ? (
                <p class="p-4 text-sm text-nhan">Chưa có tin.</p>
              ) : (
                tinMoi.map((t) => (
                  <a
                    href={`/${t.duongDanGoc}/${t.id}`}
                    class="muc-tin block px-4 py-2.5 text-sm text-muc-nhat hover:bg-khoa-nhat hover:text-khoa"
                  >
                    {t.data.tieuDe}
                    <span class="mt-0.5 block font-ma text-[11px] text-nhan-mo">{ngay(t.data.ngayTao)}</span>
                  </a>
                ))
              )
            }
          </div>
        </section>
      </aside>
    </div>

    <div class="grid gap-5 lg:grid-cols-[1.9fr_1fr]">
      <div class="flex flex-col gap-6">
        {
          noiBat.length > 0 ? (
            <section>
              <div class="thanh-muc">
                <span aria-hidden="true">🔔</span> Thông tin nổi bật
              </div>
              <div class="flex flex-col gap-3 rounded-b-o border border-t-0 border-ke bg-giay-sang p-4">
                {noiBat.map((b) => (
                  <a href={`/thong-bao/${b.id}`} class="hop-noi-bat group block">
                    <p class="font-semibold text-dau-do group-hover:underline">📢 {b.data.tieuDe}</p>
                    {b.data.tomTat ? <p class="mt-1 text-sm text-muc-nhat">{b.data.tomTat}</p> : null}
                  </a>
                ))}
              </div>
            </section>
          ) : null
        }

        <section>
          <div class="thanh-muc justify-between">
            <span>Tin tức - Thông báo</span>
            <a href="/thong-bao" class="text-xs font-normal text-white/90 hover:text-vang">
              Xem tất cả »
            </a>
          </div>
          <ul class="divide-y divide-ke rounded-b-o border border-t-0 border-ke bg-giay-sang">
            {
              thongBao.map((b) => (
                <li>
                  <a
                    href={`/thong-bao/${b.id}`}
                    class="flex items-start justify-between gap-3 px-4 py-3 hover:bg-khoa-nhat"
                  >
                    <span class="muc-tin text-sm font-medium text-muc-nhat">{b.data.tieuDe}</span>
                    <time datetime={b.data.ngayTao.toISOString()} class="shrink-0 font-ma text-[11px] text-nhan">
                      {ngay(b.data.ngayTao)}
                    </time>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        {
          tinTuc.length > 0 ? (
            <section>
              <div class="thanh-muc justify-between">
                <span>Hoạt động của khoa</span>
                <a href="/tin-tuc" class="text-xs font-normal text-white/90 hover:text-vang">
                  Xem tất cả »
                </a>
              </div>
              <div class="flex flex-col divide-y divide-ke rounded-b-o border border-t-0 border-ke bg-giay-sang">
                {tinTuc.map((t) => {
                  const laMoi = Date.now() - t.data.ngayTao.getTime() < 14 * 24 * 60 * 60 * 1000;
                  return (
                    <a href={`/tin-tuc/${t.id}`} class="flex gap-3 p-3 hover:bg-khoa-nhat">
                      {t.data.anh ? (
                        <img src={t.data.anh} alt="" class="h-20 w-28 shrink-0 rounded-o object-cover" />
                      ) : (
                        <div class="h-20 w-28 shrink-0 rounded-o bg-khoa-nhat" aria-hidden="true" />
                      )}
                      <div class="min-w-0">
                        <time datetime={t.data.ngayTao.toISOString()} class="font-ma text-[11px] text-nhan">
                          {ngay(t.data.ngayTao)}
                        </time>
                        <h3 class="mt-0.5 text-sm font-semibold leading-snug text-muc">
                          {t.data.tieuDe}
                          {laMoi ? <span class="huy-hieu ml-1.5 bg-dau-do align-middle text-white">Mới</span> : null}
                        </h3>
                        {t.data.tomTat ? <p class="mt-1 line-clamp-2 text-xs text-nhan">{t.data.tomTat}</p> : null}
                      </div>
                    </a>
                  );
                })}
              </div>
            </section>
          ) : null
        }
      </div>

      <aside class="flex flex-col gap-6">
        <section>
          <AnhHoatDong />
        </section>

        <section>
          <div class="thanh-muc">Liên kết nhanh</div>
          <div class="flex flex-col gap-2 rounded-b-o border border-t-0 border-ke bg-giay-sang p-2">
            {
              [
                {
                  d: 'https://htql.cdytdt.edu.vn/form/calendar/showFormulationAll.aspx',
                  n: 'Lịch công tác',
                  icon: '📅',
                  mau: '#f0b429',
                  chu: '#103a63',
                },
                {
                  d: 'https://vpdt.dongthap.gov.vn/',
                  n: 'Văn phòng điện tử',
                  icon: '🖥️',
                  mau: '#0b5cab',
                  chu: '#ffffff',
                },
                {
                  d: 'https://htql.cdytdt.edu.vn/login.aspx',
                  n: 'Hệ thống đào tạo',
                  icon: '🎓',
                  mau: '#1e7a4b',
                  chu: '#ffffff',
                },
                {
                  d: 'https://library.cdytdt.edu.vn/',
                  n: 'Thư viện điện tử',
                  icon: '📚',
                  mau: '#6b4fa0',
                  chu: '#ffffff',
                },
                {
                  d: 'https://thuvienphapluat.vn/',
                  n: 'Thư viện pháp luật',
                  icon: '⚖️',
                  mau: '#c0392b',
                  chu: '#ffffff',
                },
                {
                  d: 'https://htqltkb.netlify.app/',
                  n: 'Thời khóa biểu',
                  icon: '🗓️',
                  mau: '#117a8b',
                  chu: '#ffffff',
                },
                {
                  d: 'https://htqlpth.netlify.app/',
                  n: 'Quản lý phòng thực hành',
                  icon: '🔬',
                  mau: '#d68910',
                  chu: '#ffffff',
                },
              ].map((o) => (
                <a
                  href={o.d}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 rounded-o px-4 py-3 text-sm font-bold uppercase tracking-wide shadow-sm transition-opacity hover:opacity-90"
                  style={{ backgroundColor: o.mau, color: o.chu }}
                >
                  <span aria-hidden="true">{o.icon}</span>
                  {o.n}
                </a>
              ))
            }
          </div>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>
